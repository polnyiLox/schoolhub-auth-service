APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__PASSWORD=change_me
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=auth
APP_CONFIG__DB__POOL_SIZE=10
APP_CONFIG__DB__MAX_OVERFLOW=20
APP_CONFIG__DB__POOL_RECYCLE_SECONDS=1800

APP_CONFIG__API__V1_PREFIX=/v1
APP_CONFIG__API__HOST=0.0.0.0
APP_CONFIG__API__PORT=8000
APP_CONFIG__API__RELOAD=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auth

# Telegram IDs which receive the global ADMIN role on first login.
APP_CONFIG__ADMIN_TELEGRAM_IDS=[]

APP_CONFIG__MIDDLEWARE__ALLOW_ORIGINS=[]
APP_CONFIG__MIDDLEWARE__ALLOW_METHODS=["GET","POST","PATCH"]
APP_CONFIG__MIDDLEWARE__ALLOW_HEADERS=["Authorization","Content-Type"]
APP_CONFIG__MIDDLEWARE__ALLOW_CREDENTIALS=false
